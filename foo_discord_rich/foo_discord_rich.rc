    EDITTEXT        IDC_EDIT_LARGE_LIGHT_ID,101,55,203,12,ES_AUTOHSCROLL
    LTEXT           "Large image (dark):",IDC_STATIC,17,75,72,8
    EDITTEXT        IDC_EDIT_LARGE_DARK_ID,101,74,203,12,ES_AUTOHSCROLL
    LTEXT           "Playing image (light):",IDC_STATIC,17,94,72,8
    EDITTEXT        IDC_EDIT_SMALL_PLAYING_LIGHT_ID,101,93,203,12,ES_AUTOHSCROLL
    LTEXT           "Playing image (dark):",IDC_STATIC,17,112,72,8
    EDITTEXT        IDC_EDIT_SMALL_PLAYING_DARK_ID,101,111,203,12,ES_AUTOHSCROLL
    LTEXT           "Paused image (light):",IDC_STATIC,17,133,72,8
    EDITTEXT        IDC_EDIT_SMALL_PAUSED_LIGHT_ID,101,132,203,12,ES_AUTOHSCROLL
    LTEXT           "Paused image (dark):",IDC_STATIC,17,151,72,8
    EDITTEXT        IDC_EDIT_SMALL_PAUSED_DARK_ID,101,150,203,12,ES_AUTOHSCROLL
    GROUPBOX        "Art uploader",IDC_STATIC,6,173,207,91
    CTEXT           "?",IDC_LINK_ART_UPLOADER_HELP,202,173,8,8
    CONTROL         "Upload and display art (disables MusicBrainz fetcher)",IDC_CHECK_UPLOAD_ART,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,15,187,184,10
    LTEXT           "Upload command",IDC_STATIC,12,201,58,8
    EDITTEXT        IDC_EDIT_UPLOAD_COMMAND,12,213,145,14,ES_AUTOHSCROLL
    PUSHBUTTON      "Test",IDC_BUTTON_TEST_UPLOADER,162,213,44,14
    LTEXT           "Art pin query",IDC_STATIC,12,230,43,8
    EDITTEXT        IDC_EDIT_UPLOAD_ART_PIN_QUERY,12,242,194,14,ES_AUTOHSCROLL
    GROUPBOX        "Art cache",IDC_STATIC,218,173,101,91
    PUSHBUTTON      "Reload from disk",IDC_BUTTON_LOAD_CACHE,224,187,90,14
    PUSHBUTTON      "Save to disk",IDC_BUTTON_SAVE_CACHE,224,205,90,14
    PUSHBUTTON      "Open containing folder...",IDC_BUTTON_OPEN_CACHE_FOLDER,224,223,90,14
    PUSHBUTTON      "Clear cache",IDC_BUTTON_CLEAR_CACHE,224,241,90,14
END

IDD_PREFS_TROUBLESHOOTING_TAB DIALOGEX 0, 0, 327, 268
STYLE DS_SETFONT | DS_CONTROL | WS_CHILD | WS_SYSMENU
FONT 8, "Tahoma", 400, 0, 0x0
BEGIN
    GROUPBOX        "Why Discord may show another application",IDC_STATIC,6,8,314,82
    LTEXT           "Discord treats this Rich Presence and automatically recognised games or applications as separate activities.",IDC_STATIC,15,23,296,20
    LTEXT           "When both are active, Discord may display the recognised application instead of foobar2000. This component cannot inspect, reorder, or suppress other activities.",IDC_STATIC,15,49,296,32
    GROUPBOX        "Prefer foobar2000",IDC_STATIC,6,96,314,104
    LTEXT           "1. Open Discord > User Settings > Registered Games.",IDC_STATIC,15,112,296,10
    LTEXT           "2. Find the conflicting application and turn its eye icon off.",IDC_STATIC,15,128,296,10
    LTEXT           "3. Under Activity Sharing, keep `Share my activity` enabled.",IDC_STATIC,15,144,296,18
    PUSHBUTTON      "Open troubleshooting guide...",IDC_BUTTON_DISCORD_ACTIVITY_HELP,15,175,120,14
    GROUPBOX        "What artwork controls",IDC_STATIC,6,206,314,55
    LTEXT           "Album artwork changes only the large image on the foobar2000 activity card. It cannot replace another application's icon or change which activity Discord displays.",IDC_STATIC,15,221,296,30
END


