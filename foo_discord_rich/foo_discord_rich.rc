IDD_PREFS_TAB_HOST DIALOGEX 0, 0, 334, 319
STYLE DS_SETFONT | DS_FIXEDSYS | WS_CHILD | WS_CLIPSIBLINGS
EXSTYLE WS_EX_CONTROLPARENT
