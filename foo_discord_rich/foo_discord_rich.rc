    CONTROL         "Tab1",IDC_TAB_PREFS_CURRENT,"SysTabControl32",WS_TABSTOP,0,0,334,287
END

IDD_PREFS_MAIN_TAB DIALOGEX 0, 0, 327, 319
STYLE DS_SETFONT | DS_CONTROL | WS_CHILD | WS_SYSMENU
FONT 8, "Tahoma", 400, 0, 0x0
BEGIN
    CONTROL         "Enable Rich Presence",IDC_CHECK_IS_ENABLED,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,6,8,84,10
    GROUPBOX        "Text fields",IDC_STATIC,6,26,314,106
    CTEXT           "?",IDC_LINK_FORMAT_HELP,309,26,8,8
    LTEXT           "Top",IDC_STATIC,12,38,13,8
    EDITTEXT        IDC_EDIT_TOP_TEXT,12,50,301,12,ES_AUTOHSCROLL
    LTEXT           "Middle",IDC_STATIC,12,68,21,8
    EDITTEXT        IDC_EDIT_MIDDLE_TEXT,12,80,301,12,ES_AUTOHSCROLL
    LTEXT           "Bottom",IDC_STATIC,12,98,24,8
    EDITTEXT        IDC_EDIT_BOTTOM_TEXT,12,110,301,12,ES_AUTOHSCROLL
    PUSHBUTTON      "Preview current track",IDC_BUTTON_PREVIEW_PRESENCE,218,8,102,14

    GROUPBOX        "Large image fallback",IDC_STATIC,6,134,154,55
    CONTROL         "Light image",IDC_RADIO_IMG_LIGHT,"Button",BS_AUTORADIOBUTTON | WS_GROUP | WS_TABSTOP,15,147,52,10
    CONTROL         "Dark image",IDC_RADIO_IMG_DARK,"Button",BS_AUTORADIOBUTTON,15,160,51,10
    CONTROL         "Disabled",IDC_RADIO_IMG_DISABLED,"Button",BS_AUTORADIOBUTTON,15,173,43,10

    GROUPBOX        "Playback status image",IDC_STATIC,166,134,154,55
    CONTROL         "Light image",IDC_RADIO_PLAYBACK_IMG_LIGHT,"Button",BS_AUTORADIOBUTTON | WS_GROUP | WS_TABSTOP,175,147,56,10
    CONTROL         "Dark image",IDC_RADIO_PLAYBACK_IMG_DARK,"Button",BS_AUTORADIOBUTTON,175,160,64,10
    CONTROL         "Disabled",IDC_RADIO_PLAYBACK_IMG_DISABLED,"Button",BS_AUTORADIOBUTTON,175,173,43,10

    GROUPBOX        "Album artwork",IDC_STATIC,6,191,154,53
    LTEXT           "Behaviour:",IDC_STATIC,15,203,38,8
    COMBOBOX        IDC_COMBO_ARTWORK_POLICY,58,200,100,45,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    CONTROL         "Fetch and display album art from MusicBrainz",IDC_CHECK_FETCH_ALBUM_ART,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,15,217,130,10
    LTEXT           "Status: No artwork requested yet.",IDC_STATIC_ARTWORK_STATUS,15,230,135,9,SS_ENDELLIPSIS

    GROUPBOX        "Status display",IDC_STATIC,166,191,154,53
    CONTROL         "App Name",IDC_RADIO_STATUS_NAME,
                    "Button",BS_AUTORADIOBUTTON | WS_GROUP | WS_TABSTOP,175,201,65,10
    CONTROL         "Top Field",IDC_RADIO_STATUS_TOP,
                    "Button",BS_AUTORADIOBUTTON,175,213,65,10
    CONTROL         "Middle Field",IDC_RADIO_STATUS_MIDDLE,
                    "Button",BS_AUTORADIOBUTTON,175,225,75,10            

    CONTROL         "Disable Rich Presence when paused",IDC_CHECK_DISABLE_WHEN_PAUSED,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,15,307,128,10
    CONTROL         "Swap `paused` and `playing` images",IDC_CHECK_SWAP_STATUS,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,171,307,142,10
END

IDD_PREFS_ADVANCED_TAB DIALOGEX 0, 0, 327, 268
STYLE DS_SETFONT | DS_CONTROL | WS_CHILD | WS_SYSMENU
FONT 8, "Tahoma", 400, 0, 0x0
BEGIN
    LTEXT           "Discord application ID:",IDC_STATIC,13,16,87,8
    EDITTEXT        IDC_EDIT_APP_TOKEN,101,15,203,12,ES_AUTOHSCROLL | WS_GROUP
    GROUPBOX        "Rich Presence asset keys",IDC_STATIC,6,35,314,136
